.glass-tabs {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 8px;
  bottom: calc(8px + env(safe-area-inset-bottom));
  left: 0;
  display: flex;
  align-items: stretch;
  width: calc(100% - 40px);
  max-width: 360px;
  height: 62px;
  margin: 0 auto;
  padding: 4px;
  box-sizing: border-box;
  border-radius: 32px;
  background-color: rgba(250, 250, 254, 0.92);
  background-image:
    radial-gradient(ellipse at 7% 0%, rgba(255, 255, 255, 0.76), transparent 38%),
    radial-gradient(ellipse at 94% 100%, rgba(255, 255, 255, 0.62), transparent 37%);
  box-shadow:
    0 7px 20px rgba(30, 27, 55, 0.18),
    0 1px 4px rgba(30, 27, 55, 0.1);
}

@supports ((backdrop-filter: blur(6px)) or (-webkit-backdrop-filter: blur(6px))) {
  .glass-tabs {
    background-color: rgba(249, 249, 254, 0.31);
    -webkit-backdrop-filter: blur(6px) saturate(155%) brightness(1.1);
    backdrop-filter: blur(6px) saturate(155%) brightness(1.1);
  }
}

.glass-tab {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-width: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 26px;
  background: transparent;
  color: #343749;
  font-size: 11px;
  font-weight: 600;
  line-height: 14px;
  text-shadow: 0 0 4px rgba(255, 255, 255, 0.85);
  transition:
    transform 240ms cubic-bezier(0.2, 1.45, 0.4, 1),
    background-color 160ms ease;
}

.glass-tab::after {
  border: 0;
}

.glass-lens {
  position: absolute;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: calc((100% - 8px) / 3);
  pointer-events: none;
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

.glass-lens-surface {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background-color: rgba(237, 231, 255, 0.58);
  background-image: linear-gradient(155deg, rgba(255, 255, 255, 0.62), transparent 62%);
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.95),
    inset 0 -1px 2px rgba(98, 85, 231, 0.16);
  transition:
    transform 180ms cubic-bezier(0.24, 1.4, 0.45, 1),
    box-shadow 170ms ease,
    background-color 170ms ease;
}

.glass-lens-dragging {
  z-index: 1;
  transition: none;
}

.glass-lens-dragging .glass-lens-surface {
  transform: translateY(-5px) scale(var(--glass-lens-stretch, 1.15), 1.28);
  background-color: rgba(238, 231, 255, 0.3);
  box-shadow:
    0 8px 16px rgba(39, 27, 88, 0.22),
    0 0 0 1px rgba(151, 135, 208, 0.26),
    inset 2px 2px 2px rgba(255, 255, 255, 0.98),
    inset -1px -2px 2px rgba(255, 255, 255, 0.87),
    inset 0 -5px 8px rgba(120, 95, 196, 0.19);
  transition-duration: 105ms;
}

.glass-tab-selected {
  color: #4839c0;
  font-weight: 700;
}

.glass-tab-pressed {
  background-color: rgba(222, 214, 255, 0.7);
  transform: scale(0.93, 0.97);
  transition-duration: 110ms;
}

.glass-tabs-dragging .glass-tab-pressed {
  background-color: transparent;
  transform: none;
}

.glass-tabs-dragging .glass-tab-under-lens {
  transform: translateY(-3px) scale(1.1);
  transition-duration: 110ms;
}

.glass-tab-icon {
  display: block;
  width: 23px;
  height: 23px;
}

@media (prefers-reduced-transparency: reduce) {
  .glass-tabs {
    background-color: #fafafe;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .glass-tab,
  .glass-lens,
  .glass-lens-surface {
    transition: none;
  }
  .glass-tab-pressed,
  .glass-tabs-dragging .glass-tab-under-lens,
  .glass-lens-dragging .glass-lens-surface {
    transform: none;
  }
}

.glass-tabs-dark {
  background-color: rgba(32, 29, 48, 0.94);
  background-image:
    radial-gradient(ellipse at 7% 0%, rgba(185, 162, 250, 0.19), transparent 40%),
    radial-gradient(ellipse at 94% 100%, rgba(174, 147, 244, 0.13), transparent 40%);
  box-shadow: 0 7px 20px rgba(0, 0, 0, 0.43);
}
.glass-tabs-dark .glass-tab {
  color: #dfd8f4;
  text-shadow: none;
}
.glass-tabs-dark .glass-tab-icon {
  filter: brightness(1.25);
}
.glass-tabs-dark .glass-tab-selected {
  color: #e1d5ff;
}
.glass-tabs-dark .glass-tab-selected .glass-tab-icon {
  filter: brightness(1.55) saturate(0.7);
}
.glass-tabs-dark .glass-lens-surface {
  background-color: rgba(151, 120, 235, 0.31);
  background-image: linear-gradient(155deg, rgba(219, 196, 255, 0.25), transparent 65%);
  box-shadow: inset 0 1px 2px rgba(232, 213, 255, 0.32);
}
.glass-tabs-dark .glass-lens-dragging .glass-lens-surface {
  background-color: rgba(126, 95, 203, 0.54);
  box-shadow:
    0 8px 16px rgba(0, 0, 0, 0.42),
    inset 1px 1px 3px rgba(222, 192, 255, 0.56);
}
.glass-tabs-dark .glass-tab-pressed {
  background-color: rgba(137, 111, 210, 0.22);
}
@supports ((backdrop-filter: blur(6px)) or (-webkit-backdrop-filter: blur(6px))) {
  .glass-tabs-dark {
    background-color: rgba(31, 28, 46, 0.65);
    -webkit-backdrop-filter: blur(6px) saturate(145%);
    backdrop-filter: blur(6px) saturate(145%);
  }
}
@media (prefers-reduced-transparency: reduce) {
  .glass-tabs-dark {
    background-color: #222131;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
