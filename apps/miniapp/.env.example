# QQ and other external hosts require a deployed, authenticated HTTPS API.
# This is not the /p0/health URL. No AppSecret or session token belongs here.
VITE_API_BASE_URL=
VITE_P0_HEALTH_URL=

# Public independent QQ mini-program AppID; leave empty until registered.
VITE_QQ_APP_ID=

# Optional public WeChat AppID override; upload credentials belong in GitHub Secrets.
VITE_WEIXIN_APP_ID=
