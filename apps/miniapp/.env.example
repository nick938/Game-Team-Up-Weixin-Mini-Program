# QQ requires a deployed, authenticated HTTPS API.
# This is not the /p0/health URL. No AppSecret or session token belongs here.
VITE_API_BASE_URL=

# Public independent QQ mini-program AppID.
# QQ 开放平台已暂停创建新小程序（2026-10 实测），无存量账号则无法取得该 AppID。
# 详见 docs/QQ小程序接入调研.md
VITE_QQ_APP_ID=

# Optional public WeChat AppID override; upload credentials belong in GitHub Secrets.
VITE_WEIXIN_APP_ID=
