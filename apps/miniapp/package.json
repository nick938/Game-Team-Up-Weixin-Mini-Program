{
  "name": "game-team-miniapp",
  "version": "1.8.4",
  "private": true,
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1",
    "build:h5": "uni build",
    "build:weixin": "uni build -p mp-weixin",
    "build:qq": "uni build -p mp-qq",
    "build:alipay": "uni build -p mp-alipay",
    "build:toutiao": "uni build -p mp-toutiao",
    "typecheck": "vue-tsc --noEmit",
    "check:matrix": "node scripts/build-matrix.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:http": "node scripts/check-http.mjs",
    "release:plan": "node ../../scripts/miniapp/release.mjs plan",
    "release:build": "node ../../scripts/miniapp/release.mjs build",
    "release:upload": "node ../../scripts/miniapp/release.mjs upload",
    "lint": "eslint src *.config.ts --max-warnings=0",
    "lint:fix": "eslint src *.config.ts --fix",
    "format": "prettier --write src *.config.ts *.mjs *.json README.md UNIBEST.md",
    "format:check": "prettier --check src *.config.ts *.mjs *.json README.md UNIBEST.md",
    "hooks:install": "cd ../.. && node apps/miniapp/node_modules/husky/bin.js .husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-alipay": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-qq": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@wot-ui/ui": "2.3.2",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@eslint/js": "9.39.5",
    "@types/node": "20.17.9",
    "@uni-helper/plugin-uni": "0.1.0",
    "@uni-helper/unocss-preset-uni": "0.2.11",
    "@uni-helper/vite-plugin-uni-manifest": "0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "0.3.23",
    "@unocss/preset-legacy-compat": "66.0.0",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "sass": "1.98.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "unocss": "66.0.0",
    "unocss-applet": "0.11.0",
    "vite": "5.2.8",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "2.2.12"
  },
  "type": "module"
}
