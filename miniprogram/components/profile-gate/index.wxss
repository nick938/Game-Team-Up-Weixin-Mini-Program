.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 23, 20, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin-top: 12rpx;
  color: #8a8178;
  font-size: 26rpx;
  line-height: 1.6;
}

.avatar-btn {
  margin: 40rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #f4f1ec;
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8178;
}

.current {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8178;
}

.nick {
  margin-top: 16rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f4f1ec;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.submit {
  margin-top: 32rpx;
}
