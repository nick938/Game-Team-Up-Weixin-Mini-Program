<timeline-preview wx:if="{{singlePage}}" />
<block wx:else>
<view class="page publish-page">
  <view class="publish-heading">
    <view class="publish-copy">
      <view class="page-heading">{{editingId ? '调整这趟车' : (proxyMode ? '帮群友开一局' : '喊上好友，开一局')}}</view>
      <view class="page-caption">{{editingId ? '选定游戏和时间，发车后分享给好友。' : (proxyMode ? '车头是群友，发车后出现在他的「我发起的」里。' : '选定游戏和时间，发车后分享给好友。')}}</view>
    </view>
    <image class="brand-avatar" src="/images/brand/avatar-v1.jpg" mode="aspectFit" aria-label="开黑星球" />
  </view>
  <view class="form">
    <label wx:if="{{canProxy && !editingId}}" class="proxy-switch {{proxyMode ? 'proxy-switch-on' : ''}}">
      <view class="proxy-switch-copy">
        <view class="proxy-switch-title">帮群友发车</view>
        <view class="proxy-switch-hint">帮朋友代发一辆车</view>
      </view>
      <switch class="proxy-toggle" checked="{{proxyMode}}" color="#6255e7" bindchange="toggleProxy" aria-label="帮群友发车" />
    </label>

    <block wx:if="{{proxyMode && !editingId}}">
      <view id="field-proxy" class="label">帮谁发车</view>
      <view wx:if="{{proxyHost}}" class="proxy-picked">
        <image class="proxy-avatar" src="{{proxyHost.avatarBase64 ? 'data:image/jpeg;base64,' + proxyHost.avatarBase64 : (proxyHost.avatarUrl || '/images/avatar.png')}}" mode="aspectFill" />
        <view class="proxy-picked-name">{{proxyHost.nickName}}</view>
        <view class="proxy-picked-clear" catchtap="clearProxyHost">换一个</view>
      </view>
      <block wx:else>
        <input class="field" placeholder="搜对方在小程序里的昵称" maxlength="32" value="{{proxyKeyword}}" bindinput="onProxyKeyword" />
        <view class="proxy-search-hint">对方需要先打开过小程序并设置昵称</view>
        <view wx:if="{{proxySearching}}" class="proxy-search-status">搜索中…</view>
        <view wx:elif="{{proxyKeyword && !proxyResults.length}}" class="proxy-search-status">没找到这个昵称</view>
        <view wx:for="{{proxyResults}}" wx:key="userId" class="proxy-result" data-host="{{item}}" bindtap="pickProxyHost">
          <image class="proxy-avatar" src="{{item.avatarBase64 ? 'data:image/jpeg;base64,' + item.avatarBase64 : (item.avatarUrl || '/images/avatar.png')}}" mode="aspectFill" />
          <view class="proxy-result-name">{{item.nickName}}</view>
        </view>
      </block>
    </block>

    <view id="field-game" class="label">玩什么</view>
    <input
      class="field field-lg"
      placeholder="搜索游戏..."
      maxlength="40"
      value="{{gameName}}"
      bindinput="onGameName"
    />
    <view class="games suggest-games">
      <view
        class="game {{gameName === item.name ? 'game-on' : ''}}"
        wx:for="{{suggestedGames}}"
        wx:key="slug"
        data-slug="{{item.slug}}"
        bindtap="pickSuggestedGame"
      >{{item.name}}</view>
    </view>
    <view class="from-last" wx:if="{{fromLast}}">已填入上一趟，时间改到最近</view>

    <view id="field-platform" class="label">平台</view>
    <view class="games">
      <view
        class="game {{platform === item ? 'game-on' : ''}}"
        wx:for="{{platforms}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="pickPlatform"
      >{{item}}</view>
    </view>

    <view id="field-start" class="label">什么时候开始</view>
    <view class="games">
      <view
        class="game {{startPreset === item.key ? 'game-on' : ''}}"
        wx:for="{{startPresets}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickStartPreset"
      >{{item.label}}</view>
    </view>
    <view wx:if="{{startPreset === 'custom'}}" class="time-row time-row-follow">
      <picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="onStartDate">
        <view class="picker">{{startDate}}</view>
      </picker>
      <picker mode="time" value="{{startTime}}" bindchange="onStartTime">
        <view class="picker">{{startTime}}</view>
      </picker>
    </view>

    <view id="field-end" class="label">玩多久</view>
    <view class="games">
      <view
        class="game {{durationHours === item.hours ? 'game-on' : ''}}"
        wx:for="{{durationPresets}}"
        wx:key="label"
        wx:if="{{item.hours !== 0}}"
        data-hours="{{item.hours}}"
        bindtap="pickDuration"
      >{{item.label}}</view>
      <picker mode="selector" range="{{durationPickerLabels}}" value="{{durationPickerIndex}}" bindchange="pickCustomDuration">
        <view class="game {{durationHours === 0 ? 'game-on' : ''}}">自定义{{durationHours === 0 ? ' · ' + durationLabel : ''}}</view>
      </picker>
    </view>
    <view class="time-summary">
      <view class="time-summary-line1">{{timeSummaryLine1}}</view>
      <view class="time-summary-line2">{{timeSummaryLine2}}</view>
    </view>

    <view class="label">队伍人数</view>
    <view class="stepper">
      <view class="step-btn" bindtap="decCap">−</view>
      <view class="step-num">{{capacity}}</view>
      <view class="step-btn" bindtap="incCap">+</view>
    </view>
    <view class="step-hint">包含{{proxyMode && proxyHost ? '车头' : '你自己'}}</view>

    <button class="more-toggle" bindtap="toggleMore" hover-class="more-toggle-hover" aria-label="更多设置，{{showMore ? '点击收起' : '点击展开'}}">
      <view class="more-copy">
        <view class="more-title">更多设置</view>
        <view class="more-hint">{{moreHint}}</view>
      </view>
      <text class="more-chevron {{showMore ? 'more-chevron-up' : ''}}"></text>
    </button>
    <view hidden="{{!showMore}}" class="more-fields">
    <view class="label">房间 / 加入方式</view>
    <input class="field" placeholder="房间号 / Steam 好友代码 / 房间码" maxlength="80" value="{{roomNo}}" bindinput="onRoomNo" />

    <view class="label">房间密码</view>
    <input class="field" placeholder="没有就空着" maxlength="32" value="{{roomPwd}}" bindinput="onRoomPwd" />

    <view class="label">服务器 / 区服</view>
    <input class="field" placeholder="如 欧服、微信区、国服" maxlength="20" value="{{server}}" bindinput="onServer" />

    <view class="label">语音</view>
    <view class="games">
      <view
        class="game {{voice === item ? 'game-on' : ''}}"
        wx:for="{{voices}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="pickVoice"
      >{{item}}</view>
    </view>

    <view class="label">队友要求</view>
    <input class="field" placeholder="如 娱乐局、上分、萌新友好" maxlength="20" value="{{rankReq}}" bindinput="onRank" />

    <view class="field-head">
      <view class="label">备注</view>
      <view class="field-count {{note && note.length >= 500 ? 'field-count-max' : ''}}">{{note ? note.length : 0}}/500</view>
    </view>
    <textarea class="area" placeholder="玩法、麦序、怎么加好友" maxlength="500" value="{{note}}" bindinput="onNote" />
    </view>
  </view>
  <view class="submit-spacer"></view>

  <view class="submit-bar">
    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{editingId ? '保存修改' : (proxyMode && proxyHost ? '帮 TA 发车 · ' + capacity + '人' : '发车 · ' + capacity + '人')}}
    </button>
  </view>

  <profile-gate show="{{showProfile}}" bind:done="onProfileDone" bind:close="onProfileClose" />
  <welcome-letter />
</view>

</block>
