<timeline-preview wx:if="{{singlePage}}" />
<block wx:else>
<view class="page">
  <view class="publish-heading"><view class="publish-copy"><view class="page-heading">{{editingId ? '调整这趟车' : (proxyMode ? '帮群友开一局' : '喊上好友，开一局')}}</view><view class="page-caption">{{editingId ? '先定游戏和时间，发车后分享给好友。' : (proxyMode ? '车头是群友，发车后出现在他的「我发起的」里。' : '先定游戏和时间，发车后分享给好友。')}}</view></view><image class="brand-avatar" src="/images/brand/avatar-v1.jpg" mode="aspectFit" aria-label="来开黑" /></view>
  <view class="form">
    <label wx:if="{{canProxy && !editingId}}" class="proxy-switch {{proxyMode ? 'proxy-switch-on' : ''}}">
      <view class="proxy-switch-copy">
        <view class="proxy-switch-title">帮群友发车</view>
        <view class="proxy-switch-hint">群里有人喊了但没自己发车时，可以代开一趟</view>
      </view>
      <switch class="proxy-toggle" checked="{{proxyMode}}" color="#6255e7" bindchange="toggleProxy" aria-label="帮群友发车" />
    </label>

    <block wx:if="{{proxyMode && !editingId}}">
      <view class="label">帮谁发车</view>
      <view wx:if="{{proxyHost}}" class="proxy-picked">
        <image class="proxy-avatar" src="{{proxyHost.avatarBase64 ? 'data:image/jpeg;base64,' + proxyHost.avatarBase64 : (proxyHost.avatarUrl || '/images/avatar.png')}}" mode="aspectFill" />
        <view class="proxy-picked-name">{{proxyHost.nickName}}</view>
        <view class="proxy-picked-clear" catchtap="clearProxyHost">换一个</view>
      </view>
      <block wx:else>
        <input class="field" placeholder="搜对方在小程序里的昵称" maxlength="32" value="{{proxyKeyword}}" bindinput="onProxyKeyword" />
        <view class="proxy-search-hint">对方需要先打开过小程序并设置昵称</view>
        <view wx:if="{{proxySearching}}" class="proxy-search-status">搜索中…</view>
        <view wx:elif="{{proxyKeyword && !proxyResults.length}}" class="proxy-search-status">没找到这个昵称</view>
        <view wx:for="{{proxyResults}}" wx:key="userId" class="proxy-result" data-host="{{item}}" bindtap="pickProxyHost">
          <image class="proxy-avatar" src="{{item.avatarBase64 ? 'data:image/jpeg;base64,' + item.avatarBase64 : (item.avatarUrl || '/images/avatar.png')}}" mode="aspectFill" />
          <view class="proxy-result-name">{{item.nickName}}</view>
        </view>
      </block>
    </block>

    <view class="label">玩什么</view>
    <input
      class="field field-lg"
      placeholder="CS2、三角洲行动、永劫无间…"
      maxlength="40"
      value="{{gameName}}"
      bindinput="onGameName"
    />
    <view class="from-last" wx:if="{{fromLast}}">已填入上一趟，时间改到最近</view>

    <view class="label">平台</view>
    <view class="games">
      <view
        class="game {{platform === item ? 'game-on' : ''}}"
        wx:for="{{platforms}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="pickPlatform"
      >{{item}}</view>
    </view>

    <view class="label">开始时间</view>
    <view class="time-row">
      <picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="onStartDate">
        <view class="picker">{{startDate}}</view>
      </picker>
      <picker mode="time" value="{{startTime}}" bindchange="onStartTime">
        <view class="picker">{{startTime}}</view>
      </picker>
    </view>

    <view class="label">结束时间</view>
    <view class="time-row">
      <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDate">
        <view class="picker">{{endDate}}</view>
      </picker>
      <picker mode="time" value="{{endTime}}" bindchange="onEndTime">
        <view class="picker">{{endTime}}</view>
      </picker>
    </view>
    <view class="time-hint">一局最长 24 小时，到点自动散</view>

    <view class="label">几个人（含{{proxyMode && proxyHost ? '车头' : '你自己'}}）</view>
    <view class="stepper">
      <view class="step-btn" bindtap="decCap">−</view>
      <view class="step-num">{{capacity}}</view>
      <view class="step-btn" bindtap="incCap">+</view>
    </view>

    <button class="more-toggle" bindtap="toggleMore" hover-class="more-toggle-hover" aria-label="更多设置，{{showMore ? '点击收起' : '点击展开'}}">
      <view class="more-copy">
        <view class="more-title">更多设置<text class="more-optional">选填</text></view>
        <view class="more-hint">房间号、密码、区服、语音、水平、备注</view>
      </view>
      <view class="more-action">{{showMore ? '收起' : '展开'}}<text class="more-chevron {{showMore ? 'more-chevron-up' : ''}}"></text></view>
    </button>
    <view hidden="{{!showMore}}" class="more-fields">
    <view class="label">怎么进（选填）</view>
    <input class="field" placeholder="房间号 / Steam 好友代码 / 房间码" maxlength="80" value="{{roomNo}}" bindinput="onRoomNo" />

    <view class="label">进房密码（选填，仅队员可见）</view>
    <input class="field" placeholder="没有就空着" maxlength="32" value="{{roomPwd}}" bindinput="onRoomPwd" />

    <view class="label">服务器 / 区服（选填）</view>
    <input class="field" placeholder="如 欧服、微信区、国服" maxlength="20" value="{{server}}" bindinput="onServer" />

    <view class="label">语音</view>
    <view class="games">
      <view
        class="game {{voice === item ? 'game-on' : ''}}"
        wx:for="{{voices}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="pickVoice"
      >{{item}}</view>
    </view>

    <view class="label">水平（选填）</view>
    <input class="field" placeholder="如 娱乐局、上分、萌新友好" maxlength="20" value="{{rankReq}}" bindinput="onRank" />

    <view class="label">备注（选填）</view>
    <textarea class="area" placeholder="玩法、麦序、怎么加好友" maxlength="80" value="{{note}}" bindinput="onNote" />
    </view>

    <button class="btn-primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{editingId ? '保存修改' : (proxyMode && proxyHost ? '帮 TA 发车 · 共 ' + capacity + ' 人' : '发车 · 共 ' + capacity + ' 人')}}
    </button>
  </view>

  <profile-gate show="{{showProfile}}" bind:done="onProfileDone" bind:close="onProfileClose" />
  <welcome-letter />
</view>

</block>
