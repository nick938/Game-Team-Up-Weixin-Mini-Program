.hero {
  padding: 12rpx 8rpx 20rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 8rpx;
  color: #8a8178;
  font-size: 26rpx;
}

.zone {
  display: inline-flex;
  margin-bottom: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: #1a1714;
  color: #fff;
  font-size: 22rpx;
}

.empty-btn {
  margin-top: 32rpx;
  width: 280rpx;
}

.filters {
  margin: -8rpx 0 24rpx;
  white-space: nowrap;
}

.filters-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.filter {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #5c564f;
}

.filter-on {
  background: #1a1714;
  color: #fff;
}
