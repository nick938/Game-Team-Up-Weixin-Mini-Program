<view class="page">
  <view class="hero">
    <view class="hero-title">找人开一局</view>
    <view class="hero-sub">组局、分享、上车。到结束时间自动过期。</view>
  </view>

  <view class="zone">游戏区</view>

  <view wx:if="{{loading && !list.length}}" class="empty">正在拉组局…</view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view>现在没有正在招募的局。</view>
    <view>自己开一趟，把卡片丢进群里。</view>
    <button class="btn-primary empty-btn" bindtap="goPublish">去组局</button>
  </view>

  <team-card
    wx:for="{{list}}"
    wx:key="_id"
    team="{{item}}"
    bind:tap="onOpen"
  />
</view>
