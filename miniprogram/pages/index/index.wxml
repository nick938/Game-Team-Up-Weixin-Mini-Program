<timeline-preview wx:if="{{singlePage}}" />
<block wx:else>
<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="hero-title">找游戏搭子，一起开黑</view>
      <view class="hero-sub">王者开黑、三角洲搭子、瓦搭子、和平精英搭子，快速找到一起玩的队友。</view>
    </view>
    <image class="hero-art" src="/images/brand/lobby-v1.jpg" mode="aspectFit" aria-hidden="true" />
  </view>

  <view class="seo-games">
    <view class="seo-kicker">热门游戏搭子</view>
    <view class="seo-game-list">
      <navigator
        wx:for="{{featured}}"
        wx:key="seoKey"
        class="seo-game"
        url="/pages/game/game?game={{item.seoKey}}"
        hover-class="seo-game-hover"
      >{{item.entryLabel}}</navigator>
    </view>
  </view>

  <view class="section-head">
    <view class="zone">现在的车<text class="section-count">{{filtered.length}}/{{total}}</text></view>
    <view class="sorts">
      <view
        class="sort {{sortMode === item.key ? 'sort-on' : ''}}"
        wx:for="{{sorts}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickSort"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="toolbar">
    <view class="search">
      <input
        class="search-input"
        type="text"
        placeholder="搜索游戏 / 区服"
        value="{{keyword}}"
        maxlength="20"
        confirm-type="search"
        bindinput="onSearch"
      />
      <text wx:if="{{keyword}}" class="search-clear" catchtap="clearSearch">✕</text>
    </view>
    <scroll-view wx:if="{{games.length > 1}}" class="filters" scroll-x>
      <view class="filters-inner">
        <view
          class="filter {{gameFilter === item ? 'filter-on' : ''}}"
          wx:for="{{games}}"
          wx:key="*this"
          data-name="{{item}}"
          bindtap="pickGame"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading && !total}}" class="empty">正在找车…</view>
  <view wx:elif="{{!total}}" class="empty">
    <image class="empty-art" src="/images/brand/empty-v1.jpg" mode="aspectFit" lazy-load aria-hidden="true" />
    <view class="empty-title">没找到合适的队伍？</view>
    <view class="empty-sub">可以去发车，等队友来上车</view>
    <button class="list-end-btn" bindtap="goPublish">去发车</button>
  </view>
  <view wx:elif="{{!filtered.length && keyword}}" class="empty">
    <view>已加载的车里没搜到「{{keyword}}」。</view>
    <button wx:if="{{hasMore}}" class="btn-ghost empty-btn" bindtap="loadMore">继续加载更多</button>
    <button wx:else class="btn-ghost empty-btn" bindtap="clearSearch">清空搜索</button>
  </view>
  <view wx:elif="{{!filtered.length}}" class="empty">
    <image class="empty-art" src="/images/brand/empty-v1.jpg" mode="aspectFit" lazy-load aria-hidden="true" />
    <view class="empty-title">没找到合适的队伍？</view>
    <view class="empty-sub">可以去发车，等队友来上车</view>
    <button class="list-end-btn" bindtap="goPublish">去发车</button>
  </view>

  <team-card
    wx:for="{{filtered}}"
    wx:key="_id"
    team="{{item}}"
    team-id="{{item.id || item._id}}"
    mark="{{item.mark}}"
    bind:open="onOpen"
  />
  <view wx:if="{{filtered.length && loadingMore}}" class="load-more">正在加载更多…</view>
  <view wx:elif="{{filtered.length && !hasMore}}" class="list-end">
    <view class="list-end-title">没找到合适的队伍？</view>
    <view class="list-end-sub">可以去发车，等队友来上车</view>
    <button class="list-end-btn" bindtap="goPublish">去发车</button>
  </view>
  <view wx:elif="{{filtered.length && hasMore}}" class="load-more">上拉加载更多</view>
  <welcome-letter />
</view>

</block>
