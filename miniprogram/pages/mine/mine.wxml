<view class="page">
  <view class="me card" bindtap="editProfile">
    <image class="avatar" src="{{user.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
    <view class="me-text">
      <view class="name">{{user.nickName || '点这里设置头像昵称'}}</view>
      <view class="tip">点击修改头像和昵称</view>
    </view>
  </view>

  <view class="section-title">我发的车 · 进行中</view>
  <team-card
    wx:for="{{hostedOngoing}}"
    wx:key="_id"
    team="{{item}}"
    mark="车头"
    bind:tap="onOpen"
  />
  <view wx:if="{{!hostedOngoing.length}}" class="mini-empty">没有正在进行的车</view>

  <view class="section-title">我上的车 · 进行中</view>
  <team-card
    wx:for="{{joinedOngoing}}"
    wx:key="_id"
    team="{{item}}"
    mark="队员"
    bind:tap="onOpen"
  />
  <view wx:if="{{!joinedOngoing.length}}" class="mini-empty">没有正在上的车</view>

  <view class="section-title">我发的车 · 已结束</view>
  <team-card
    wx:for="{{hostedPast}}"
    wx:key="_id"
    team="{{item}}"
    mark="车头"
    bind:tap="onOpen"
  />
  <view wx:if="{{!hostedPast.length}}" class="mini-empty">还没有结束的车</view>

  <view class="section-title">我上的车 · 已结束</view>
  <team-card
    wx:for="{{joinedPast}}"
    wx:key="_id"
    team="{{item}}"
    mark="队员"
    bind:tap="onOpen"
  />
  <view wx:if="{{!joinedPast.length}}" class="mini-empty">还没上过别人的车</view>

  <view class="legal">
    <text data-type="agreement" bindtap="openLegal">用户协议</text>
    <text class="dot">·</text>
    <text data-type="privacy" bindtap="openLegal">隐私政策</text>
  </view>

  <profile-gate show="{{showProfile}}" bind:done="onProfileDone" />
</view>
