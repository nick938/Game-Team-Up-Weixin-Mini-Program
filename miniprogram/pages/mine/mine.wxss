.card { background: #fff; border: 1rpx solid #e9ebf3; border-radius: 28rpx; padding: 28rpx; }
.me { display: flex; align-items: center; padding: 12rpx 0 28rpx; background: transparent; border: none; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 36rpx; background: #eeecff; margin-right: 24rpx; flex-shrink: 0; }
.me-text { min-width: 0; }
.name { font-size: 38rpx; font-weight: 700; word-break: break-all; }
.tip { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #777e92; }
.tabs { display: flex; margin-top: 36rpx; gap: 36rpx; border-bottom: 1rpx solid #e5e8f1; }
button.tab { width: auto; min-width: 0; padding: 0 0 22rpx; color: #858ba0; font-size: 32rpx; font-weight: 600; }
.tab-active { color: #202438; border-bottom: 5rpx solid #6255e7; }
.list-head { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 0; }
.phases { display: flex; gap: 12rpx; }
button.phase { width: auto; min-width: 0; font-size: 24rpx; padding: 12rpx 20rpx; border-radius: 12rpx; color: #777e92; }
.phase-active { color: #6255e7; background: #eae7ff; }
.list-total { font-size: 23rpx; color: #858ba0; }
.empty { padding: 40rpx 28rpx; }
.empty-sub { font-size: 24rpx; margin: 6rpx 0 24rpx; }
.empty .btn-ghost { width: 280rpx; margin: 0 auto; }
.legal { margin-top: 36rpx; text-align: center; color: #858ba0; font-size: 23rpx; }
.legal text { display: inline-block; padding: 20rpx 0; }
.dot { margin: 0 16rpx; }
button.feedback-link { margin-top: 8rpx; font-size: 23rpx; color: #6255e7; }
.version { margin-top: 8rpx; text-align: center; font-size: 22rpx; color: #a0a6b8; }
