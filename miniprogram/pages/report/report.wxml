<view class="page">
  <view class="page-heading">举报</view>
  <view class="page-caption">如果这趟车涉及广告、辱骂或违规内容，告诉我们，我们会尽快处理。</view>

  <view class="target card">
    <view class="target-label">举报对象</view>
    <view class="target-name">{{targetName || '这趟车已不存在'}}</view>
  </view>

  <view class="form">
    <view class="label">举报理由</view>
    <view class="games">
      <view
        class="game {{reason === item ? 'game-on' : ''}}"
        wx:for="{{reasons}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="pickReason"
      >{{item}}</view>
    </view>

    <view class="label">补充说明（选填）</view>
    <textarea
      class="area"
      maxlength="500"
      value="{{content}}"
      bindinput="onContent"
      placeholder="方便的话，说说具体是什么情况"
    />
    <view class="hint">举报会记录你的账号，恶意举报可能影响使用。</view>

    <button class="btn-primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交举报</button>
  </view>
</view>
